<resources>
    <string name="app_name">Nothing Essential Remapper</string>
    <string name="accessibility_service_label">Essential Key Remapper</string>
    <string name="accessibility_service_description">Watches for Essential Key presses so you can assign it custom actions. It does not read what is on your screen.</string>

    <string name="action_back">Back</string>

    <string name="onboarding_title">Welcome</string>
    <string name="onboarding_intro_title">What this app does</string>
    <string name="onboarding_intro_body">It lets you assign custom actions to the Essential Key on your Nothing phone. Single press, double press, triple press and long press can each trigger a different action.</string>
    <string name="onboarding_pc_title">You will need a PC (once)</string>
    <string name="onboarding_pc_body">To fully take over the key, setup requires running two ADB commands from a computer, or via wireless debugging — just once. After that, everything runs on the phone.</string>
    <string name="onboarding_how_title">How it works</string>
    <string name="onboarding_how_body">Once set up, you pick an action for each gesture: open an app, toggle the flashlight, control media playback, and more.</string>
    <string name="onboarding_cta">Get started</string>

